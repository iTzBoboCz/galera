DATABASE_URL="mysql://root:root@localhost:3306/galera"
FRONTEND_URL=http://localhost:4173/ # or port 5173 for `npm run dev`
BACKEND_URL=http://localhost:4173/api/ # or port 5173 for `npm run dev`
OIDC_PROVIDER_KEY=exampleprovider
OIDC_DISPLAY_NAME=Example
OIDC_ISSUER=https://keycloak.example.com/realms/{realmname}
OIDC_CLIENT_ID=galera
OIDC_CLIENT_SECRET=clientsecret
OIDC_ALLOW_SIGNUP=true
OIDC_REDIRECT_URL=http://localhost:8000/auth/oidc/{providerkey}/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4173/login
OIDC_LINK_EXISTING_BY_EMAIL=false
DISABLE_LOCAL_SIGNUPS=false
DISABLE_LOCAL_AUTH=false
RUST_LOG=info
tower_http=info
RUST_BACKTRACE=full
